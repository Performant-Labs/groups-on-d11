<?php

/**
 * @file
 * Install, update, and uninstall functions for the DO Notifications module.
 */

/**
 * Implements hook_schema().
 *
 * Part of the Notifications epic #237, N-1 (#229). Defines the
 * `do_notifications_queue` table backing
 * `Drupal\do_notifications\Queue\DatabaseQueueBackend` — the DB-persistent
 * swap-in for N-2's (#230) in-memory `MockQueueBackend`
 * (see `do_notifications.services.yml`).
 *
 * The unique key on (uid, mid, frequency, day) is the dedup enforcement
 * {@see \Drupal\do_notifications\Queue\QueueBackendInterface::enqueue()}
 * requires: a second enqueue() with an identical tuple must be a silent
 * no-op, matching `MockQueueBackend`'s in-memory `$seenKeys` contract
 * exactly. `DatabaseQueueBackend::enqueue()` relies on this key via
 * `Connection::merge()->keys([...])`, so no separate SELECT-then-INSERT
 * race window or try/catch-on-duplicate-key is needed.
 *
 * `send_at` (nullable int) was added by N-5 (#233): the unix timestamp at
 * which a delivery/digest worker (N-3/N-6/N-7) should include the entry.
 * NOT part of the dedup tuple — a user flipping their frequency preference
 * mid-day produces a NEW row (discriminated by `frequency` in the unique
 * key), not an update to an existing row's `send_at`. The composite
 * `frequency_send_at` index supports the digest workers' anticipated query
 * pattern `WHERE frequency = ? AND send_at <= NOW()`.
 *
 * Also defines `do_notifications_digest_queue` (#234, N-6): the destination
 * table for the daily/weekly digest worker's aggregated, per-recipient
 * output — see
 * {@see \Drupal\do_notifications\Queue\DigestQueueBackendInterface} and
 * `Drupal\do_notifications\Commands\DigestCommands::digestDaily()`. This is
 * a deliberately separate table from `do_notifications_queue`: a digest row
 * has no single `mid` (it aggregates N source rows) and carries the fully
 * rendered `subject`/`body_text`/`body_html` payload, which the per-message
 * queue's `(uid, mid, frequency, day)` dedup contract cannot express.
 */
function do_notifications_schema() {
  $schema['do_notifications_queue'] = [
    'description' => 'Per-recipient queued notification entries awaiting a future digest/frequency worker (N-3+, out of scope for this story).',
    'fields' => [
      'id' => [
        'description' => 'Primary key: unique queue entry ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'The recipient user ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'mid' => [
        'description' => 'The routed Message entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'template' => [
        'description' => "The Message's template (message_template) ID.",
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'frequency' => [
        'description' => "The recipient's notification frequency (e.g. 'immediately', 'daily', 'weekly').",
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'day' => [
        'description' => "The enqueue date, 'Y-m-d' format. Part of the dedup key: an overlapping subscription on the SAME day collapses, while a later day's routing for the same (uid, mid, frequency) is a distinct entry.",
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'The UNIX timestamp the entry was enqueued.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'send_at' => [
        'description' => "N-5 (#233): the UNIX timestamp at which the delivery/digest worker should include this entry. NULL only if the enqueuer did not resolve a schedule (never happens once SubscriptionRouter is in the path — kept nullable for cross-version safety on rows written before this column existed).",
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uid_mid_frequency_day' => ['uid', 'mid', 'frequency', 'day'],
    ],
    'indexes' => [
      // Not required by this story's acceptance criteria; anticipates the
      // N-3+ digest worker's "find everything due for a given
      // frequency/day" query pattern.
      'frequency_day' => ['frequency', 'day'],
      // N-5 (#233): the digest workers' primary query pattern —
      // WHERE frequency = ? AND send_at <= NOW(). Composite ordering
      // matches the equality-then-range access pattern.
      'frequency_send_at' => ['frequency', 'send_at'],
    ],
  ];

  $schema['do_notifications_digest_queue'] = [
    'description' => 'Aggregated per-recipient digest emails awaiting delivery by the (not-yet-merged) N-3 delivery worker. Populated by the N-6 daily digest command (and, later, N-7 weekly) via DatabaseDigestQueueBackend; each row is one fully rendered digest for one user, distinct from do_notifications_queue which holds the per-message entries a digest aggregates and consumes.',
    'fields' => [
      'id' => [
        'description' => 'Primary key: unique digest queue entry ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'The recipient user ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'window' => [
        'description' => "The digest window this row was aggregated for: 'daily' or 'weekly'.",
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'subject' => [
        'description' => 'The rendered digest email subject line.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'body_text' => [
        'description' => 'The rendered plain-text digest email body.',
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'body_html' => [
        'description' => 'The rendered HTML digest email body.',
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
      ],
      'send_at' => [
        'description' => 'UNIX timestamp: the earliest time this digest may be sent.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'The UNIX timestamp this digest row was enqueued.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      // The N-3 delivery worker's query pattern: "find everything due for
      // delivery" is `WHERE send_at <= NOW()`.
      'send_at' => ['send_at'],
    ],
  ];

  return $schema;
}

/**
 * N-5 (#233): add nullable `send_at` column + `(frequency, send_at)` index.
 *
 * Idempotent — safe to re-run. For sites installed via N-1 (#229) before
 * N-5 landed, this adds the column so DatabaseQueueBackend can persist the
 * schedule stamp SubscriptionRouter now writes on every enqueue. Fresh
 * installs pick this up via the updated hook_schema() directly, so this
 * hook_update_N is a no-op on those.
 */
function do_notifications_update_10001(): string {
  $schema = \Drupal::database()->schema();
  $added = FALSE;

  if (!$schema->fieldExists('do_notifications_queue', 'send_at')) {
    $schema->addField('do_notifications_queue', 'send_at', [
      'description' => 'N-5 (#233): the UNIX timestamp at which the delivery/digest worker should include this entry.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
    ]);
    $added = TRUE;
  }

  if (!$schema->indexExists('do_notifications_queue', 'frequency_send_at')) {
    $schema->addIndex(
      'do_notifications_queue',
      'frequency_send_at',
      ['frequency', 'send_at'],
      [
        'fields' => [
          'frequency' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
          'send_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        ],
      ],
    );
  }

  return $added
    ? 'Added send_at column and (frequency, send_at) index to do_notifications_queue.'
    : 'send_at column already present; ensured (frequency, send_at) index exists.';
}

/**
 * Adds the `do_notifications_digest_queue` table for existing sites.
 *
 * Part of the Notifications epic #237, N-6 (#234). Sites that installed
 * `do_notifications` before this update only have `do_notifications_queue`
 * (defined by `do_notifications_schema()` at N-1); this brings their schema
 * up to date with the new digest-queue table a fresh install already gets
 * via `hook_schema()`.
 */
function do_notifications_update_11001() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('do_notifications_digest_queue')) {
    $full_schema = do_notifications_schema();
    $schema->createTable('do_notifications_digest_queue', $full_schema['do_notifications_digest_queue']);
  }
}
